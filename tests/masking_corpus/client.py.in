import os
from typing import Optional

DEFAULT_TIMEOUT = 30


class Client:
    def __init__(self, user: str, password: str, token: Optional[str] = None):
        self.user = user
        self.password = password
        self.token = token

    def connect(self):
        password = os.environ["DB_PASSWORD"]
        return open_session(user=self.user, password=password, token=self.token)

    def headers(self) -> dict:
        return {"Authorization": f"Bearer {self.token}"}
